# Copy to /etc/hotzonex-backup.env on the Droplet and fill in. Keep it private:
#   sudo chmod 600 /etc/hotzonex-backup.env
# Never commit the filled-in file.

# Supabase → Connect → "Session pooler" connection string (works over IPv4), with your
# database password in place of [YOUR-PASSWORD].
DATABASE_URL='postgresql://postgres.tyiwnaxdejtsdofgnuow:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres'

# DigitalOcean → Spaces Object Storage: the bucket, its region, and a Spaces access key
# limited to this bucket.
SPACES_BUCKET='hotzonex-backups'
SPACES_REGION='fra1'
SPACES_KEY=''
SPACES_SECRET=''

# Days of backups to keep.
KEEP_DAYS=30
