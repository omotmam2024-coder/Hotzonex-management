# Supabase project URL — Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase service role key (secret, keep only on this computer) — Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 64 hex characters (32 bytes) shared with the add-router Edge Function; generate once with: openssl rand -hex 32
ROUTER_SECRET_KEY=replace-with-64-hex-characters
# How often to check for new router jobs, in milliseconds
JOB_POLL_INTERVAL_MS=3000
# How often to sync router status and active users, in milliseconds
SYNC_INTERVAL_MS=60000
# Timeout for each RouterOS REST request, in milliseconds
ROUTER_TIMEOUT_MS=10000
